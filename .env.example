DATABASE_URL=sqlite:///./data/app.db

# mock = canned text, no model needed (default, used by the test suite)
# ollama = local model served by Ollama on LLM_BASE_URL
LLM_PROVIDER=mock
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=220

MIN_CALORIES_MALE=1500
MIN_CALORIES_FEMALE=1200
MAX_DEFICIT_RATIO=0.25

LOG_LEVEL=INFO
